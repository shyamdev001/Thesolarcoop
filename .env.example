# Copy to .env.local (git-ignored) for local dev, and set the same values
# in your hosting provider's environment variables for production.
#
# SMTP credentials for the quote form (app/api/quote/route.ts). Works with
# whatever mailbox already hosts sales@thesolarcoop.in — Zoho Mail, Google
# Workspace, a cPanel mailbox, etc. Check your provider's SMTP settings page
# for the exact host/port; these are just common examples.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@thesolarcoop.in
SMTP_PASS=

# Optional — default to SMTP_USER / sales@thesolarcoop.in if unset.
MAIL_FROM=sales@thesolarcoop.in
MAIL_TO=sales@thesolarcoop.in

# Google Analytics 4 (components/Analytics.tsx). Leave unset to load nothing
# at all — no placeholder ID, no script tag, until a real one is set. Must
# be NEXT_PUBLIC_-prefixed (it's read in the browser). Get it from
# analytics.google.com → Admin → Data Streams → your web stream → Measurement ID.
NEXT_PUBLIC_GA_ID=
